# TraceVigil AI Backend Environment Variables
# Copy this file to backend/.env and fill in your real values.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/traceability
JWT_SECRET=replace-with-a-long-random-secret

# Email alerts (optional - set to true only if you want email notifications)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=yourmail@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_TO=yourmail@gmail.com
